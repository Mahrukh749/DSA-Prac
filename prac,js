public class MoveZeros {

    public static void moveZeroes(int[] arr) {
        int index = 0;

        // Step 1: non-zero elements ko aage le ao
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] != 0) {
                arr[index] = arr[i];
                index++;
            }
        }

        // Step 2: baqi jagahon par zero daal do
        while (index < arr.length) {
            arr[index] = 0;
            index++;
        }
    }

    public static void main(String[] args) {
        int[] arr = {0, 1, 0, 3, 12};

        moveZeroes(arr);

        // output print
        for (int num : arr) {
            System.out.print(num + " ");
        }
    }
}