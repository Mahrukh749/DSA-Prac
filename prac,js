function reverseArray(arr) {
  let start = 0;
  let end = arr.length - 1;

  while (start < end) {
    [arr[start], arr[end]] = [arr[end], arr[start]];

    start++;
    end--;
  }
  return arr;
}

let myArr = [10, 20, 30, 40, 50];
console.log("Original:", myArr);
console.log("Reversed:", reverseArray(myArr));
