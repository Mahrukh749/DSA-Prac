function linearSearch(arr, target) {
  for (let i = 0; i < arr.length; i++) {
    if (arr[i] === target) {
      return i; // Element mil gaya, index return karo
    }
  }
  return -1; // Element nahi mila
}

const numbers = [10, 25, 30, 45, 50];
console.log(linearSearch(numbers, 45)); // Output: 3
